# ── Foodie App — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=3000
NODE_ENV=development
# e.g. for local dev: mongodb://127.0.0.1:27017/foodieDB
# for Atlas:  mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/foodieDB
MONGODB_URI=mongodb://127.0.0.1:27017/foodieDB

# Session — generate a strong random string:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Admin dashboard credentials (used by POST /admin-login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
